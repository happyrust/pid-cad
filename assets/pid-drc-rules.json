{
  "version": 1,
  "pack": "内置规则包",
  "rule_set_version": "1.0.0",
  "legend_standard": null,
  "save_gate": "warn",
  "connect_tolerance": 0.000001,
  "required_fields": {
    "EQUIPMENT": ["名称"],
    "PIPE_LINE": ["流体介质"]
  },
  "loop_roles": {
    "控制器": ["controller"],
    "测量元件": ["transmitter", "indicator"]
  },
  "sets": [
    { "name": "基础规则", "enabled": true },
    { "name": "工程扩展", "enabled": true }
  ],
  "rules": [
    {
      "id": "DR-001",
      "name": "管线缺管道等级",
      "set": "基础规则",
      "category": "设计类",
      "target": "管线",
      "severity": "错误",
      "expr": "管道等级 = NULL",
      "message": "管线 {位号} 没有管道等级",
      "fix": "给管线填写管道等级：PIDSETPROP {位号} 管道等级 <值>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-002",
      "name": "管线缺公称直径",
      "set": "基础规则",
      "category": "设计类",
      "target": "管线",
      "severity": "错误",
      "expr": "公称直径 = NULL",
      "message": "管线 {位号} 没有公称直径",
      "fix": "给管线填写公称直径：PIDSETPROP {位号} 公称直径 <值>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-003",
      "name": "设备无位号",
      "set": "基础规则",
      "category": "设计类",
      "target": "设备",
      "severity": "错误",
      "expr": "位号 = NULL OR 位号 = \"\"",
      "message": "设备（{类型}）没有位号",
      "fix": "选中这台设备，在属性表里填写位号",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-004",
      "name": "位号重复",
      "set": "基础规则",
      "category": "设计类",
      "target": "对象实例",
      "severity": "错误",
      "expr": "位号.同类型重复数 > 1",
      "message": "{类型} 的位号 {位号} 在本图重复",
      "fix": "选中其中一个，在属性表里改成不重复的位号",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-005",
      "name": "仪表未分配回路",
      "set": "基础规则",
      "category": "设计类",
      "target": "仪表",
      "severity": "警告",
      "expr": "仪表回路 = NULL",
      "message": "仪表 {位号} 没有分配仪表回路",
      "fix": "填写仪表回路：PIDSETPROP {位号} 仪表回路 <回路号>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-006",
      "name": "页间连接符对端缺失",
      "set": "基础规则",
      "category": "设计类",
      "target": "页间连接符",
      "severity": "错误",
      "expr": "对端图纸 = NULL OR 对端位号 = NULL",
      "message": "{所属} 上的页间连接符缺对端图纸或对端位号",
      "fix": "用 PIDPAIR 把它和另一张图上的连接符配对",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-007",
      "name": "阀门压力等级高于管道等级",
      "set": "基础规则",
      "category": "设计类",
      "target": "阀门",
      "severity": "错误",
      "expr": "压力等级 > 所属管线.管道等级.最大公称压力",
      "message": "阀门 {位号} 的压力等级 {压力等级} 高于所属管线管道等级的最大公称压力",
      "fix": "换压力等级合适的阀门，或核对所属管线的管道等级",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-008",
      "name": "管口未连接",
      "set": "基础规则",
      "category": "设计类",
      "target": "管口",
      "severity": "提示",
      "expr": "连接状态 = #未连接",
      "message": "{所属} 的管口 {名称} 没有接上",
      "fix": "接上管线；本来就不接的管口可以豁免",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-009",
      "name": "图纸未设图例标准",
      "set": "基础规则",
      "category": "设计类",
      "target": "图纸",
      "severity": "错误",
      "expr": "图例标准 = NULL",
      "message": "图纸 {图号} 没有设图例标准",
      "fix": "配置项目主数据并写明图例标准（PIDMASTERDATA）",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-010",
      "name": "属性必填项为空",
      "set": "基础规则",
      "category": "设计类",
      "target": "对象实例",
      "severity": "错误",
      "expr": "必填项缺失数 > 0",
      "message": "{类型} {位号} 有 {必填项缺失数} 个必填属性没填",
      "fix": "在属性表里填写缺的属性",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-011",
      "name": "管路位号后缀缺失",
      "set": "基础规则",
      "category": "设计类",
      "target": "管路",
      "severity": "错误",
      "expr": "后缀 = NULL OR 后缀 = \"\"",
      "message": "管路 {位号} 的位号没有后缀",
      "fix": "把管路位号写成「管线位号-后缀」",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-012",
      "name": "管段长度非法",
      "set": "基础规则",
      "category": "设计类",
      "target": "管段",
      "severity": "警告",
      "expr": "长度 <= 0",
      "message": "{所属} 上有一段管段长度为 0",
      "fix": "删掉这段管段，或重画",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-013",
      "name": "仪表回路仪表数不足",
      "set": "基础规则",
      "category": "设计类",
      "target": "仪表回路",
      "severity": "提示",
      "expr": "仪表数 < 2",
      "message": "仪表回路 {回路号} 只有 {仪表数} 个仪表",
      "fix": "核对回路号，或补上回路里的其他仪表",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-014",
      "name": "管线端口未闭合",
      "set": "基础规则",
      "category": "设计类",
      "target": "管线",
      "severity": "错误",
      "expr": "端口未连接数 > 0",
      "message": "管线 {位号} 有 {端口未连接数} 个端点没接上",
      "fix": "把端点接到设备、管件或其他管线上；放空、排净的管端可以豁免",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-015",
      "name": "信号线端点缺失",
      "set": "基础规则",
      "category": "设计类",
      "target": "信号线",
      "severity": "错误",
      "expr": "起点仪表 = NULL OR 终点仪表 = NULL",
      "message": "信号线 {位号} 没有两端都接到仪表上",
      "fix": "把信号线两端都接到仪表上",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-016",
      "name": "标注文字为空",
      "set": "基础规则",
      "category": "设计类",
      "target": "标注",
      "severity": "提示",
      "expr": "文字 = NULL OR 文字 = \"\"",
      "message": "标注没有文字",
      "fix": "填写标注文字，或删掉这个标注",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-017",
      "name": "阀门开度越界",
      "set": "基础规则",
      "category": "设计类",
      "target": "阀门",
      "severity": "警告",
      "expr": "开度 > 100 OR 开度 < 0",
      "message": "阀门 {位号} 的开度 {开度} 不在 0 到 100 之间",
      "fix": "改正开度：PIDSETPROP {位号} 开度 <0 到 100>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-018",
      "name": "位号格式不符",
      "set": "基础规则",
      "category": "设计类",
      "target": "对象实例",
      "severity": "警告",
      "expr": "位号合规 = FALSE",
      "message": "{类型} {位号} 的位号不符合这个类型的位号规则",
      "fix": "按位号规则改位号：PIDTAG {位号} <新位号>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-019",
      "name": "位号长度超限",
      "set": "基础规则",
      "category": "设计类",
      "target": "对象实例",
      "severity": "提示",
      "expr": "位号.长度 > 32",
      "message": "位号 {位号} 超过 32 个字符",
      "fix": "改短位号：PIDTAG {位号} <新位号>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-020",
      "name": "管口位号前缀不继承设备",
      "set": "基础规则",
      "category": "设计类",
      "target": "管口",
      "severity": "错误",
      "expr": "位号前缀 != 所属设备.位号",
      "message": "{所属} 的管口 {名称} 的位号前缀与设备位号不一致",
      "fix": "让管口位号以设备位号开头",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-021",
      "name": "介质与管道等级材质不兼容",
      "set": "基础规则",
      "category": "设计类",
      "target": "管线",
      "severity": "错误",
      "expr": "流体介质 IN (#氯气, #氢氟酸) AND 管道等级.材质 = #碳钢",
      "message": "管线 {位号} 输送 {流体介质}，管道等级 {管道等级} 的材质是碳钢",
      "fix": "换用材质耐这种介质的管道等级",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-022",
      "name": "管道等级不在项目主数据",
      "set": "基础规则",
      "category": "设计类",
      "target": "管线",
      "severity": "错误",
      "expr": "管道等级 NOT IN (项目.管道等级表)",
      "message": "管线 {位号} 的管道等级 {管道等级} 不在项目主数据里",
      "fix": "改用主数据里有的管道等级，或先在主数据里加上它",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-023",
      "name": "设备管口数不足",
      "set": "基础规则",
      "category": "设计类",
      "target": "设备",
      "severity": "警告",
      "expr": "管口数 < 2 AND NOT (设备类别 = #储罐)",
      "message": "设备 {位号} 只有 {管口数} 个管口",
      "fix": "核对设备符号，管口不够就换一个符号",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-024",
      "name": "符号实例状态非法",
      "set": "基础规则",
      "category": "设计类",
      "target": "符号实例",
      "severity": "提示",
      "expr": "符号.状态 != #有效",
      "message": "{类型} {位号} 的符号在当前符号库里找不到",
      "fix": "换成符号库里有的符号，或补上符号库",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-025",
      "name": "高温管线缺绝热等级",
      "set": "基础规则",
      "category": "设计类",
      "target": "管线",
      "severity": "警告",
      "expr": "(设计温度 > 200 OR 流体介质 = #蒸汽) AND 绝热等级 = NULL",
      "message": "管线 {位号} 是高温或蒸汽管线，没有绝热等级",
      "fix": "填写绝热等级：PIDSETPROP {位号} 绝热等级 <值>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-101",
      "name": "仪表或阀门无位号",
      "set": "工程扩展",
      "category": "设计类",
      "target": "对象实例",
      "severity": "错误",
      "expr": "种类 IN (#仪表, #阀门) AND (位号 = NULL OR 位号 = \"\")",
      "message": "{种类}（{类型}）没有位号",
      "fix": "选中它，在属性表里填写位号",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-102",
      "name": "跨图纸位号重复",
      "set": "工程扩展",
      "category": "设计类",
      "target": "对象实例",
      "severity": "错误",
      "expr": "位号.跨图重复数 > 0",
      "message": "{类型} 的位号 {位号} 在别的图纸上也有",
      "fix": "改成项目里不重复的位号，或核对是不是同一个对象画在了两张图上",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-103",
      "name": "公称直径不在项目主数据",
      "set": "工程扩展",
      "category": "设计类",
      "target": "对象实例",
      "severity": "错误",
      "expr": "种类 IN (#管线, #管路) AND 公称直径 NOT IN (项目.公称直径表)",
      "message": "{种类} {位号} 的公称直径 {公称直径} 不在项目主数据里",
      "fix": "改用主数据里有的公称直径：PIDSETPROP {位号} 公称直径 <值>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-104",
      "name": "流体介质不在项目主数据",
      "set": "工程扩展",
      "category": "设计类",
      "target": "管线",
      "severity": "错误",
      "expr": "流体介质 NOT IN (项目.流体介质表)",
      "message": "管线 {位号} 的流体介质 {流体介质} 不在项目主数据里",
      "fix": "改用主数据里有的流体介质，或先在主数据里加上它",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-105",
      "name": "管径突变处没有异径管",
      "set": "工程扩展",
      "category": "设计类",
      "target": "管路",
      "severity": "警告",
      "expr": "直连异径管路数 > 0",
      "message": "管路 {位号} 与公称直径不同的管路直接相接",
      "fix": "在变径处加异径管",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-106",
      "name": "阀门公称直径与所在管路不一致",
      "set": "工程扩展",
      "category": "设计类",
      "target": "阀门",
      "severity": "警告",
      "expr": "公称直径 != 所属管路.公称直径",
      "message": "阀门 {位号} 的公称直径 {公称直径} 与所在管路不一致",
      "fix": "改成与所在管路相同的公称直径：PIDSETPROP {位号} 公称直径 <值>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-107",
      "name": "阀门或管件的管道等级与所在管线不一致",
      "set": "工程扩展",
      "category": "设计类",
      "target": "对象实例",
      "severity": "警告",
      "expr": "种类 IN (#阀门, #管件) AND 管道等级 != 所属管线.管道等级",
      "message": "{类型} {位号} 的管道等级 {管道等级} 与所在管线不一致",
      "fix": "改成与所在管线相同的管道等级：PIDSETPROP {位号} 管道等级 <值>",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-108",
      "name": "信号线接到了设备管口",
      "set": "工程扩展",
      "category": "设计类",
      "target": "信号线",
      "severity": "警告",
      "expr": "接到设备管口数 > 0",
      "message": "信号线 {位号} 接到了设备管口上",
      "fix": "信号线只接仪表；工艺连接用管线",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-109",
      "name": "单向阀或调节阀流向与管路相反",
      "set": "工程扩展",
      "category": "设计类",
      "target": "阀门",
      "severity": "错误",
      "expr": "流向相反 = TRUE",
      "message": "阀门 {位号} 的流向与管路相反",
      "fix": "把阀门转过来，让流向与管路一致",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-110",
      "name": "管段重叠",
      "set": "工程扩展",
      "category": "设计类",
      "target": "管段",
      "severity": "警告",
      "expr": "重叠管段数 > 0",
      "message": "{所属} 上有管段与别的管段重叠",
      "fix": "删掉重叠的那一段",
      "scope": "项目",
      "scope_ref": null,
      "enabled": true,
      "source": "内置",
      "params": {}
    },
    {
      "id": "DR-111",
      "name": "阀门或管件有端口没接上",
      "set": "工程扩展",
      "category": "设计类",
      "target": "对象实例",
      "severity": "警告",
      "expr": "种类 IN (#阀门, #管件) AND 未连接端口数 > 0",
      "message": "{类型} {位号} 有 {未连接端口数} 个端口没接上",
