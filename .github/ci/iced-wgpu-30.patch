diff --git a/wgpu/src/external.rs b/wgpu/src/external.rs
new file mode 100644
index 00000000..345bde72
--- /dev/null
+++ b/wgpu/src/external.rs
@@ -0,0 +1,38 @@
+//! Shared GPU handles for embedding an external wgpu renderer.
+//!
+//! The compositor stores clones of its instance / adapter / device / queue
+//! here right after device creation. An embedding application (OpenCADStudio
+//! embeds Bevy this way) can then initialize a second renderer *on the same
+//! `wgpu::Device`*, so its output textures are directly bindable by iced-side
+//! pipelines — no cross-device copies.
+//!
+//! Native only: wgpu handles are not `Send + Sync` on wasm, and the only
+//! consumer (the Bevy bridge) is a desktop feature.
+
+#![cfg(not(target_arch = "wasm32"))]
+
+use std::sync::OnceLock;
+
+/// Clones of the GPU handles the compositor rendered with. All wgpu handles
+/// are internally reference-counted, so these are cheap aliases of the live
+/// objects, valid for the lifetime of the process.
+#[derive(Debug, Clone)]
+pub struct GpuHandles {
+    pub instance: wgpu::Instance,
+    pub adapter: wgpu::Adapter,
+    pub device: wgpu::Device,
+    pub queue: wgpu::Queue,
+}
+
+static SHARED: OnceLock<GpuHandles> = OnceLock::new();
+
+/// Called by the compositor once its device exists. First compositor wins;
+/// iced applications have one compositor per process.
+pub(crate) fn store(handles: GpuHandles) {
+    let _ = SHARED.set(handles);
+}
+
+/// The GPU handles of the running compositor, if one has been created.
+pub fn gpu_handles() -> Option<&'static GpuHandles> {
+    SHARED.get()
+}
